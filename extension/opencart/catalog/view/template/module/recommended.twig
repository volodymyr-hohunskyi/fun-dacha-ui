{% if products %}
<div class="recommended-products-section mb-5">
  <h3 class="mb-4">{{ heading_title }}</h3>
  <div class="row{% if axis == 'horizontal' %} row-cols-1 row-cols-sm-2 row-cols-md-3 {% if home_layout|default(false) %}row-cols-lg-5 row-cols-xl-5{% else %}row-cols-xl-4{% endif %}{% endif %}">
    {% for product in products %}
      <div class="col mb-3">{{ product }}</div>
    {% endfor %}
  </div>
</div>
{% endif %}




