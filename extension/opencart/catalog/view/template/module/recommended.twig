{% if products %}
<div class="recommended-products-section mb-5">
  <h3 class="mb-4">{{ heading_title }}</h3>
  <div class="row{% if axis == 'horizontal' %} row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-3{% endif %}">
    {% for product in products %}
      <div class="col mb-3">{{ product }}</div>
    {% endfor %}
  </div>
</div>
{% endif %}




