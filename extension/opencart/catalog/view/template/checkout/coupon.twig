<div class="accordion-item checkout-coupon-compact">
  <h2 class="accordion-header"><button type="button" class="accordion-button collapsed py-2" data-bs-toggle="collapse" data-bs-target="#collapse-coupon">{{ heading_title }}</button></h2>
  <div id="collapse-coupon" class="accordion-collapse collapse" data-bs-parent="#accordion">
    <div class="accordion-body py-2">
      <form id="form-coupon" data-oc-toggle="ajax" data-oc-load="{{ list }}" data-oc-target="#shopping-cart">
        <div class="row g-2 mb-2 align-items-center">
          <label for="input-coupon" class="col-12 col-md-4 col-form-label col-form-label-sm mb-0">{{ entry_coupon }}</label>
          <div class="col-12 col-md-8">
            <input type="text" name="coupon" value="{{ coupon }}" placeholder="{{ entry_coupon }}" id="input-coupon" class="form-control form-control-sm"/>
          </div>
        </div>
      </form>
      <div class="text-end">
        <button type="submit" form="form-coupon" formaction="{{ save }}" class="btn btn-primary btn-sm">{{ button_coupon }}</button>
        <button type="submit" form="form-coupon" formaction="{{ remove }}" class="btn btn-danger btn-sm">{{ button_remove }}</button>
      </div>
    </div>
  </div>
</div>
