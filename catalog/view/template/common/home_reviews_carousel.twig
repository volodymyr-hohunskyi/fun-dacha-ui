{% if reviews %}
<section class="home-reviews-carousel-section">
  <div class="container">
    <h3 class="mb-4">{{ heading_title }}</h3>
    <div id="carousel-home-reviews" class="carousel slide">
      {% if reviews|length > 5 %}
        <div class="carousel-indicators">
          {% set rev_slide = 0 %}
          {% for carousel_group in reviews|batch(5) %}
            <button type="button" data-bs-target="#carousel-home-reviews" data-bs-slide-to="{{ rev_slide }}"{% if rev_slide == 0 %} class="active"{% endif %} aria-label="Slide {{ rev_slide + 1 }}"></button>
            {% set rev_slide = rev_slide + 1 %}
          {% endfor %}
        </div>
      {% endif %}
      <div class="carousel-inner">
        {% for carousel_group in reviews|batch(5) %}
          <div class="carousel-item{% if loop.first %} active{% endif %}">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3 g-lg-4">
              {% for review in carousel_group %}
                <div class="col">
                  <div class="card h-100 home-review-card">
                    <a href="{{ review.href }}" class="home-review-card__image-link">
                      <img src="{{ review.thumb }}" alt="{{ review.product_name }}" class="card-img-top img-fluid home-review-card__thumb" loading="lazy"/>
                    </a>
                    <div class="card-body d-flex flex-column">
                      <a href="{{ review.href }}" class="text-decoration-none home-review-card__product-title">{{ review.product_name }}</a>
                      <div class="rating mb-2" aria-label="{{ review.rating }} / 5">
                        {% for i in 1..5 %}
                          {% if review.rating < i %}
                            <span class="fa-stack"><i class="fa-regular fa-star fa-stack-1x"></i></span>
                          {% else %}
                            <span class="fa-stack"><i class="fa-solid fa-star fa-stack-1x"></i><i class="fa-regular fa-star fa-stack-1x"></i></span>
                          {% endif %}
                        {% endfor %}
                      </div>
                      <p class="card-text small flex-grow-1 mb-2">{{ review.text }}</p>
                      <p class="small text-muted mb-0 mt-auto"><strong>{{ review.author }}</strong> · {{ review.date_added }}</p>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if reviews|length > 5 %}
        <button type="button" class="carousel-control-prev" data-bs-target="#carousel-home-reviews" data-bs-slide="prev">
          <span class="fa-solid fa-chevron-left text-dark" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button type="button" class="carousel-control-next" data-bs-target="#carousel-home-reviews" data-bs-slide="next">
          <span class="fa-solid fa-chevron-right text-dark" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      {% endif %}
    </div>
    <script type="text/javascript"><!--
    document.addEventListener('DOMContentLoaded', function() {
        var el = document.querySelector('#carousel-home-reviews');
        if (el) {
            new bootstrap.Carousel(el, { interval: false, wrap: true });
        }
    });
    //--></script>
  </div>
</section>
{% endif %}
