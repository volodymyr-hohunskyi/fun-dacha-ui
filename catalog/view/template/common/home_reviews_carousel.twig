{% if reviews %}
<section class="home-reviews-carousel-section">
  <div class="container">
    <h3 class="section-heading mb-4">{{ heading_title }}</h3>
    <div id="carousel-home-reviews" class="carousel slide">
      <div class="carousel-inner">
        {% for carousel_group in reviews|batch(5) %}
          <div class="carousel-item{% if loop.first %} active{% endif %}">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
              {% for review in carousel_group %}
                <div class="col">
                  <div class="home-review-card">
                    <a href="{{ review.href }}" class="home-review-card__image-link">
                      <img src="{{ review.thumb }}" alt="{{ review.product_name }}" class="home-review-card__thumb" loading="lazy"/>
                    </a>
                    <div class="home-review-card__body">
                      <a href="{{ review.href }}" class="home-review-card__product-title">{{ review.product_name }}</a>
                      <div class="home-review-card__stars" aria-label="{{ review.rating }} / 5">
                        {% for i in 1..5 %}
                          {% if review.rating < i %}
                            <i class="fa-regular fa-star"></i>
                          {% else %}
                            <i class="fa-solid fa-star"></i>
                          {% endif %}
                        {% endfor %}
                      </div>
                      <p class="home-review-card__text">{{ review.text }}</p>
                      <p class="home-review-card__author"><strong>{{ review.author }}</strong> · {{ review.date_added }}</p>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if reviews|length > 5 %}
        <button type="button" class="carousel-control-prev" data-bs-target="#carousel-home-reviews" data-bs-slide="prev">
          <span class="fa-solid fa-chevron-left text-dark" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button type="button" class="carousel-control-next" data-bs-target="#carousel-home-reviews" data-bs-slide="next">
          <span class="fa-solid fa-chevron-right text-dark" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      {% endif %}
    </div>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var el = document.querySelector('#carousel-home-reviews');
        if (el) new bootstrap.Carousel(el, { interval: false, wrap: true });
    });
    </script>
  </div>
</section>
{% endif %}
