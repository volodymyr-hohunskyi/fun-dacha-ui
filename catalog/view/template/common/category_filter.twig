{% if filter_groups %}
<aside class="category-filter-widget mb-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="h6 mb-0">{{ text_filter }}</h4>
    {% if filter_reset_href %}
    <a href="{{ filter_reset_href }}" class="btn btn-sm btn-primary">{{ text_filter_reset }}</a>
    {% endif %}
  </div>
  <div id="filter-accordion" class="accordion accordion-flush">
    {% for group in filter_groups %}
      <div class="accordion-item border-0 border-bottom">
        <h2 class="accordion-header">
          <button type="button" class="accordion-button py-2 px-0 bg-transparent shadow-none border-0 rounded-0 fw-semibold small" data-bs-toggle="collapse" data-bs-target="#filter-group-{{ loop.index }}" aria-expanded="true" aria-controls="filter-group-{{ loop.index }}">
            {{ group.name }}
          </button>
        </h2>
        <div id="filter-group-{{ loop.index }}" class="accordion-collapse collapse show">
          <div class="accordion-body pt-0 pb-2 px-0">
            <ul class="list-unstyled mb-0">
              {% for filter in group.filters %}
                <li class="mb-1">
                  <a href="{{ filter.href }}" class="text-decoration-none d-flex align-items-center{% if filter.checked %} filter-checked{% endif %}">
                    <span class="filter-checkbox me-2 d-inline-flex align-items-center justify-content-center border" style="width:18px;height:18px;">
                      {% if filter.checked %}
                        <i class="fa-solid fa-check fa-sm text-primary"></i>
                      {% endif %}
                    </span>
                    <span>{{ filter.name }}</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</aside>
{% endif %}
