<div class="header-cart-widget dropdown">
  <a href="{{ cart }}" class="header-cart-widget__trigger" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="fa-solid fa-cart-shopping"></i>
    {% if product_count > 0 %}
    <span class="header-cart-widget__badge">{{ product_count }}</span>
    {% endif %}
    <span class="header-cart-widget__total d-none d-md-inline">{{ total_formatted }}</span>
  </a>
  <div class="dropdown-menu dropdown-menu-end header-cart-widget__dropdown">
    {% if products %}
      <div class="header-cart-widget__items">
        {% for product in products[:3] %}
        <div class="header-cart-widget__item">
          {% if product.thumb %}
          <a href="{{ product.href }}" class="header-cart-widget__thumb">
            <img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy"/>
          </a>
          {% endif %}
          <div class="header-cart-widget__info">
            <a href="{{ product.href }}" class="header-cart-widget__name">{{ product.name }}</a>
            {% if product.cart_pack %}
            <div class="header-cart-widget__meta">{{ product.cart_pack.pack_label }}</div>
            {% endif %}
            <div class="header-cart-widget__price">{{ product.quantity }} x {{ product.price }}</div>
          </div>
          <form action="{{ remove }}" method="post" data-oc-toggle="ajax" data-oc-load="{{ list }}" data-oc-target="#cart">
            <input type="hidden" name="key" value="{{ product.cart_id }}">
            <button type="submit" class="header-cart-widget__remove" aria-label="{{ button_remove }}"><i class="fa-solid fa-xmark"></i></button>
          </form>
        </div>
        {% endfor %}
        {% if products|length > 3 %}
        <div class="header-cart-widget__more">
          ...та ще {{ products|length - 3 }} товар(ів)
        </div>
        {% endif %}
      </div>
      <div class="header-cart-widget__totals">
        {% for total in totals %}
        <div class="header-cart-widget__total-row">
          <span>{{ total.title }}</span>
          <strong>{{ total.text }}</strong>
        </div>
        {% endfor %}
      </div>
      <div class="header-cart-widget__actions">
        <a href="{{ cart }}" class="btn btn-outline-primary btn-sm">{{ text_cart }}</a>
        <a href="{{ checkout }}" class="btn btn-primary btn-sm">{{ text_checkout }}</a>
      </div>
    {% else %}
      <div class="header-cart-widget__empty">
        <i class="fa-solid fa-cart-shopping"></i>
        <p>{{ text_no_results }}</p>
        <a href="{{ cart }}" class="btn btn-primary btn-sm">Перейти до каталогу</a>
      </div>
    {% endif %}
  </div>
</div>
