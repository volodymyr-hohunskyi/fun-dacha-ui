<section class="newsletter-section">
  <div class="container">
    <div class="newsletter-section__inner">
      <div class="newsletter-section__text">
        <h3 class="newsletter-section__title"><i class="fa-solid fa-envelope me-2"></i>Отримуйте поради та акції</h3>
        <p class="newsletter-section__desc">Підпишіться на розсилку і отримуйте корисні поради для городу та знижки першими</p>
      </div>
      <form class="newsletter-section__form" method="post" action="{{ action }}">
        <input type="email" name="email" placeholder="Ваш email" class="newsletter-section__input" required/>
        <button type="submit" class="newsletter-section__btn">Підписатися</button>
      </form>
    </div>
  </div>
</section>
