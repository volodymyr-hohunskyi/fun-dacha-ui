{% if bundles %}
<section class="home-bundles">
  <div class="container">
    <div class="home-bundles__header">
      <h2 class="home-bundles__title"><i class="fa-solid fa-box-open"></i> {{ heading_title }}</h2>
      <p class="home-bundles__subtitle">{{ heading_subtitle }}</p>
    </div>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-3">
      {% for bundle in bundles %}
        <div class="col">
          {% if bundle.href %}
            <a href="{{ bundle.href }}" class="home-bundles__card">
              <div class="home-bundles__img-wrap">
                <img src="{{ bundle.image }}" alt="{{ bundle.name }}" class="home-bundles__img" loading="lazy">
              </div>
              <span class="home-bundles__link">Переглянути <i class="fa-solid fa-arrow-right"></i></span>
            </a>
          {% else %}
            <div class="home-bundles__card">
              <div class="home-bundles__img-wrap">
                <img src="{{ bundle.image }}" alt="{{ bundle.name }}" class="home-bundles__img" loading="lazy">
              </div>
              <span class="home-bundles__link" style="color:var(--color-text-muted)">Незабаром</span>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
