{% if bundles %}
<section class="home-bundles">
  <div class="container">
    <div class="home-bundles__header">
      <h2 class="home-bundles__title"><i class="fa-solid fa-box-open"></i> {{ heading_title }}</h2>
      <p class="home-bundles__subtitle">{{ heading_subtitle }}</p>
    </div>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-2">
      {% for bundle in bundles %}
        <div class="col">
          {% set tag = bundle.href ? 'a' : 'div' %}
          <{{ tag }}{% if bundle.href %} href="{{ bundle.href }}"{% endif %} class="home-bundles__card{% if not bundle.href %} home-bundles__card--soon{% endif %}">
            <img src="{{ bundle.image }}" alt="{{ bundle.name }}" class="home-bundles__img" loading="lazy">
          </{{ tag }}>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
