{% if products %}
<div class="home-promotions-section mb-5">
  <h3 class="mb-4">{{ heading_title }}</h3>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-3">
    {% for product in products %}
      <div class="col mb-3">{{ product }}</div>
    {% endfor %}
  </div>
</div>
{% endif %}
