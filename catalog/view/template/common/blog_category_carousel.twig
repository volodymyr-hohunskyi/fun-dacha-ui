{% if categories %}
<section class="blog-category-tags-carousel mb-3">
  <div class="container px-0">
    <h2 class="blog-category-tags-title h6 mb-2 text-muted">{{ heading_title }}</h2>
    <div id="carousel-blog-categories" class="carousel slide">
      {% if categories|length > per_slide %}
        <div class="carousel-indicators">
          {% for carousel_group in categories|batch(per_slide) %}
            <button type="button" data-bs-target="#carousel-blog-categories" data-bs-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active"{% endif %} aria-label="Slide {{ loop.index }}"></button>
          {% endfor %}
        </div>
      {% endif %}
      <div class="carousel-inner">
        {% for carousel_group in categories|batch(per_slide) %}
          <div class="carousel-item{% if loop.first %} active{% endif %}">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-start blog-category-tags-row">
              {% for cat in carousel_group %}
                <a href="{{ cat.href }}" class="btn btn-sm btn-outline-secondary rounded-pill blog-category-tag">{{ cat.name }}</a>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if categories|length > per_slide %}
        <button type="button" class="carousel-control-prev blog-category-carousel-control" data-bs-target="#carousel-blog-categories" data-bs-slide="prev">
          <span class="fa-solid fa-chevron-left text-dark" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button type="button" class="carousel-control-next blog-category-carousel-control" data-bs-target="#carousel-blog-categories" data-bs-slide="next">
          <span class="fa-solid fa-chevron-right text-dark" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      {% endif %}
    </div>
  </div>
  <script type="text/javascript"><!--
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.querySelector('#carousel-blog-categories');
    if (el) {
      new bootstrap.Carousel(el, { interval: false, wrap: true });
    }
  });
  //--></script>
</section>
{% endif %}
