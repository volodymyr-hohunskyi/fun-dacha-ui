          <p class="freshgo-footer-store-name">{{ name }}</p>
          {% if address %}
            <p><i class="fa-solid fa-location-dot me-2"></i>{{ address }}</p>
          {% endif %}
          <p><i class="fa-solid fa-phone me-2"></i>{{ telephone }}</p>
          <p><i class="fa-solid fa-envelope me-2"></i>{{ email }}</p>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5>{{ text_information }}</h5>
          <ul class="list-unstyled">
            {% if blog %}
              <li><a href="{{ blog }}">{{ text_blog }}</a></li>
            {% endif %}
            {% for information in informations %}
              <li><a href="{{ information.href }}">{{ information.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5>{{ text_news }}</h5>
