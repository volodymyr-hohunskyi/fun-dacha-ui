</main>
<footer class="freshgo-footer">
  <div class="freshgo-footer-newsletter">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-5 mb-3 mb-lg-0">
          <h4 class="freshgo-footer-newsletter-title">{{ text_newsletter_title }}</h4>
          <p class="freshgo-footer-newsletter-desc mb-0">{{ text_newsletter_desc }}</p>
        </div>
        <div class="col-lg-7">
          <a href="{{ newsletter_action }}" class="btn btn-primary freshgo-footer-newsletter-btn">{{ text_subscribe }}</a>
        </div>
      </div>
    </div>
  </div>
  <div class="freshgo-footer-content">
    <div class="container">
      <div class="row">
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5>{{ text_contact_us }}</h5>
          <p class="freshgo-footer-store-name">{{ name }}</p>
          {% if address %}
            <p><i class="fa-solid fa-location-dot me-2"></i>{{ address }}</p>
          {% endif %}
          <p><i class="fa-solid fa-phone me-2"></i>{{ telephone }}</p>
          <p><i class="fa-solid fa-envelope me-2"></i>{{ email }}</p>
          <div class="freshgo-footer-social mt-3">
            <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
            <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" aria-label="Pinterest"><i class="fa-brands fa-pinterest"></i></a>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5>{{ text_information }}</h5>
          <ul class="list-unstyled">
            {% if blog %}
              <li><a href="{{ blog }}">{{ text_blog }}</a></li>
            {% endif %}
            {% for information in informations %}
              <li><a href="{{ information.href }}">{{ information.title }}</a></li>
            {% endfor %}
            {% if manufacturer %}
              <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
            {% endif %}
          </ul>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5>{{ text_account }}</h5>
          <ul class="list-unstyled">
            <li><a href="{{ account }}">{{ text_account }}</a></li>
            <li><a href="{{ order }}">{{ text_order }}</a></li>
            <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
            <li><a href="{{ newsletter_href }}">{{ text_newsletter }}</a></li>
            <li><a href="{{ special }}">{{ text_special }}</a></li>
          </ul>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5>{{ text_service }}</h5>
          <ul class="list-unstyled">
            <li><a href="{{ contact }}">{{ text_contact }}</a></li>
            <li><a href="{{ return }}">{{ text_return }}</a></li>
            {% if gdpr %}
              <li><a href="{{ gdpr }}">{{ text_gdpr }}</a></li>
            {% endif %}
            <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="freshgo-footer-bottom">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-12 text-center py-3">
          <p class="mb-0">{{ powered }}</p>
        </div>
      </div>
    </div>
  </div>
</footer>
</div>
{{ cookie }}
<script src="{{ bootstrap }}" type="text/javascript"></script>
{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
</body></html>
