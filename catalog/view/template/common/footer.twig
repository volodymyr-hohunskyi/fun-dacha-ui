</main>
<footer class="site-footer">
  <div class="site-footer__main">
    <div class="container">
      <div class="row">
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5 class="site-footer__heading">Про нас</h5>
          <p class="site-footer__store">{{ name }}</p>
          {% for information in informations %}
            <a href="{{ information.href }}" class="site-footer__link">{{ information.title }}</a>
          {% endfor %}
          {% if blog %}
            <a href="{{ blog }}" class="site-footer__link">{{ text_blog }}</a>
          {% endif %}
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5 class="site-footer__heading">Каталог</h5>
          {% for category in categories %}
            <a href="{{ category.href }}" class="site-footer__link">{{ category.name }}</a>
          {% endfor %}
          <a href="{{ special }}" class="site-footer__link">{{ text_special }}</a>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5 class="site-footer__heading">Допомога</h5>
          <a href="{{ contact }}" class="site-footer__link">{{ text_contact }}</a>
          {% if gdpr %}
            <a href="{{ gdpr }}" class="site-footer__link">{{ text_gdpr }}</a>
          {% endif %}
          <a href="{{ sitemap }}" class="site-footer__link">{{ text_sitemap }}</a>
        </div>
        <div class="col-md-6 col-lg-3 mb-4 mb-lg-0">
          <h5 class="site-footer__heading">{{ text_contact_us }}</h5>
          {% if address %}
            <p class="site-footer__contact"><i class="fa-solid fa-location-dot"></i> {{ address }}</p>
          {% endif %}
          <p class="site-footer__contact"><i class="fa-solid fa-phone"></i> {{ telephone }}</p>
          <p class="site-footer__contact"><i class="fa-solid fa-envelope"></i> {{ email }}</p>
          <p class="site-footer__contact"><i class="fa-solid fa-clock"></i> Пн-Пт 9:00-18:00</p>
        </div>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="container">
      <p class="mb-0">{{ powered }}</p>
    </div>
  </div>
</footer>
</div>
{{ cookie }}
{{ assistant_widget }}
<script src="{{ bootstrap }}" type="text/javascript"></script>
{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
</body></html>
