{% if products %}
<div class="featured-seeds-section">
  <h3 class="section-heading mb-4">{{ heading_title }}</h3>
  <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
    {% for product in products %}
      <div class="col">{{ product }}</div>
    {% endfor %}
  </div>
</div>
{% endif %}
