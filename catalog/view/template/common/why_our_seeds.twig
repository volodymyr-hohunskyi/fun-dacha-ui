<section class="why-our-seeds-section">
  <div class="container">
    <h3 class="section-heading mb-3">{{ heading_title }}</h3>
    <p class="why-our-seeds__intro">{{ text_intro }}</p>
    <div class="why-our-seeds__grid">
      {% for feature in features %}
        <div class="why-our-seeds__card">
          <div class="why-our-seeds__icon">
            <i class="fa-solid {{ feature.icon }}"></i>
          </div>
          <span class="why-our-seeds__title">{{ feature.title }}</span>
        </div>
      {% endfor %}
    </div>
    <a href="{{ library_href }}" class="btn btn-outline-primary mt-3">{{ text_library }}</a>
  </div>
</section>
