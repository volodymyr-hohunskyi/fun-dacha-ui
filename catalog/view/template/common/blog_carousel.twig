{% if articles %}
<section class="blog-carousel-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
      <h3 class="mb-0">{{ heading_title }}</h3>
      <a href="{{ blog_href }}" class="btn btn-outline-primary">{{ text_view_all }}</a>
    </div>
    <div id="carousel-blog" class="carousel slide" data-bs-ride="carousel">
      {% if articles|length > 3 %}
        <div class="carousel-indicators">
          {% set blog_row = 0 %}
          {% for carousel_group in articles|batch(3) %}
            <button type="button" data-bs-target="#carousel-blog" data-bs-slide-to="{{ blog_row }}"{% if blog_row == 0 %} class="active"{% endif %}></button>
            {% set blog_row = blog_row + 1 %}
          {% endfor %}
        </div>
      {% endif %}
      <div class="carousel-inner">
        {% set blog_row = 0 %}
        {% for carousel_group in articles|batch(3) %}
          <div class="carousel-item{% if blog_row == 0 %} active{% endif %}">
            <div class="row g-4">
              {% for article in carousel_group %}
                <div class="col-md-4">
                  <a href="{{ article.href }}" class="text-decoration-none text-dark">
                    <div class="card h-100 overflow-hidden blog-carousel-card">
                      {% if article.thumb %}
                      <img src="{{ article.thumb }}" alt="{{ article.name }}" class="card-img-top img-fluid" style="object-fit: cover; height: 200px;"/>
                      {% endif %}
                      <div class="card-body">
                        <h5 class="card-title h6">{{ article.name }}</h5>
                        <p class="card-text small text-muted mb-0">{{ article.description }}</p>
                      </div>
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>
          {% set blog_row = blog_row + 1 %}
        {% endfor %}
      </div>
      {% if articles|length > 3 %}
        <button type="button" class="carousel-control-prev" data-bs-target="#carousel-blog" data-bs-slide="prev">
          <span class="fa-solid fa-chevron-left text-dark"></span>
        </button>
        <button type="button" class="carousel-control-next" data-bs-target="#carousel-blog" data-bs-slide="next">
          <span class="fa-solid fa-chevron-right text-dark"></span>
        </button>
      {% endif %}
    </div>
    <script type="text/javascript"><!--
    document.addEventListener('DOMContentLoaded', function() {
        var el = document.querySelector('#carousel-blog');
        if (el) new bootstrap.Carousel(el, { interval: 6000, wrap: true });
    });
    //--></script>
  </div>
</section>
{% endif %}
