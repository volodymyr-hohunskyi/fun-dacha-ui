{% if articles %}
<section class="blog-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
      <h3 class="section-heading mb-0">{{ heading_title }}</h3>
      <a href="{{ blog_href }}" class="btn btn-outline-primary btn-sm">{{ text_view_all }} <i class="fa-solid fa-arrow-right ms-1"></i></a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-3">
      {% for article in articles[:3] %}
        <div class="col">
          <a href="{{ article.href }}" class="blog-card">
            {% if article.thumb %}
              <div class="blog-card__image">
                <img src="{{ article.thumb }}" alt="{{ article.name }}" loading="lazy"/>
              </div>
            {% endif %}
            <div class="blog-card__body">
              <h5 class="blog-card__title">{{ article.name }}</h5>
              <p class="blog-card__desc">{{ article.description }}</p>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
