{% if links %}
<section class="article-links-carousel-section">
  <h2 class="article-links-carousel-title">{{ heading_title }}</h2>
  <div id="{{ carousel_id }}" class="carousel slide">
    {% if links|length > per_slide %}
      <div class="carousel-indicators">
        {% for carousel_group in links|batch(per_slide) %}
          <button type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active"{% endif %} aria-label="Slide {{ loop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}
    <div class="carousel-inner">
      {% for carousel_group in links|batch(per_slide) %}
        <div class="carousel-item{% if loop.first %} active{% endif %}">
          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-6 g-3">
            {% for link in carousel_group %}
              <div class="col">
                <a href="{{ link.href }}" class="article-links-carousel-card h-100">{{ link.name }}</a>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if links|length > per_slide %}
      <button type="button" class="carousel-control-prev" data-bs-target="#{{ carousel_id }}" data-bs-slide="prev">
        <span class="fa-solid fa-chevron-left text-dark" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button type="button" class="carousel-control-next" data-bs-target="#{{ carousel_id }}" data-bs-slide="next">
        <span class="fa-solid fa-chevron-right text-dark" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    {% endif %}
  </div>
  <script type="text/javascript"><!--
  document.addEventListener('DOMContentLoaded', function() {
      var el = document.querySelector('#{{ carousel_id }}');
      if (el && typeof bootstrap !== 'undefined') {
          new bootstrap.Carousel(el, { interval: false, wrap: true });
      }
  });
  //--></script>
</section>
{% endif %}
