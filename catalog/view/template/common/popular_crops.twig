{% if categories %}
<section class="popular-crops-section mt-4 mb-5">
  <div class="container">
    <h2 class="popular-crops-title text-start mb-4">{{ heading_title }}</h2>
    <div class="row row-cols-2 row-cols-md-2 row-cols-lg-4 g-4">
      {% for category in categories %}
        <div class="col">
          <a href="{{ category.href }}" class="popular-crop-card text-center text-decoration-none d-block">
            <div class="popular-crop-image mb-2">
              <img src="{{ category.image }}" alt="{{ category.name }}" class="img-fluid"/>
            </div>
            <span class="popular-crop-name">{{ category.name }}</span>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
