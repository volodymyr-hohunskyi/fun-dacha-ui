{{ header }}
{% if schema_breadcrumb %}
<script type="application/ld+json">
{{ schema_breadcrumb }}
</script>
{% endif %}
<div id="product-category" class="container">
  <nav class="category-breadcrumb" aria-label="breadcrumb">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item{% if loop.last %} active{% endif %}">
          {% if loop.last %}{{ breadcrumb.text }}{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>

  <div class="row">
    {% if filter_widget %}
      <aside id="column-left" class="col-md-3 d-none d-md-block">{{ filter_widget }}</aside>
      <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="offcanvas-filters" aria-labelledby="offcanvas-filters-label">
        <div class="offcanvas-header">
          <h5 class="offcanvas-title" id="offcanvas-filters-label">Фільтри</h5>
          <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрити"></button>
        </div>
        <div class="offcanvas-body">{{ filter_widget }}</div>
      </div>
    {% endif %}

    <div id="content" class="col">{{ content_top }}
      <h1>{{ heading_title }}</h1>

      {% if description %}
        <div class="category-desc-collapse mb-3">
          <div class="category-desc-text">{{ description }}</div>
        </div>
      {% endif %}

      {% if products %}
        <div class="category-toolbar">
          {% if filter_widget %}
            <button class="btn btn-outline-primary btn-sm d-md-none category-toolbar__filter-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-filters">
              <i class="fa-solid fa-sliders me-1"></i> Фільтри
            </button>
          {% endif %}
          {% if product_total is defined %}
            <span class="category-toolbar__count">Знайдено {{ product_total }} товарів</span>
          {% endif %}
          <div class="category-toolbar__sort ms-auto">
            <select id="input-sort" class="form-select form-select-sm" onchange="location = this.value;">
              {% for sorts in sorts %}
                <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div id="product-list" class="row row-cols-2 row-cols-sm-2 row-cols-md-2 row-cols-lg-4 g-3">
          {% for product in products %}
            <div class="col">{{ product }}</div>
          {% endfor %}
        </div>

        <div class="category-pagination">
          <div>{{ pagination }}</div>
          <div class="category-pagination__results">{{ results }}</div>
        </div>
      {% endif %}

      {% if not products %}
        <div class="category-empty">
          <i class="fa-solid fa-seedling fa-3x text-muted mb-3"></i>
          <p>{{ text_no_results }}</p>
          <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
        </div>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
