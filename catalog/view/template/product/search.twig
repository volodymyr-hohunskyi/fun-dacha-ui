{{ header }}
<div id="product-search" class="container">
  <nav class="category-breadcrumb" aria-label="breadcrumb">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item{% if loop.last %} active{% endif %}">
          {% if loop.last %}{{ breadcrumb.text }}{% else %}<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>{% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
  <div class="row">
    {{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      {% if search %}
        <h1 class="search-results__heading">Результати для &laquo;{{ search }}&raquo;</h1>
      {% else %}
        <h1>{{ heading_title }}</h1>
      {% endif %}

      {% if products %}
        <div class="category-toolbar">
          <span class="category-toolbar__count">{{ results }}</span>
          <div class="category-toolbar__sort ms-auto">
            <select id="input-sort" class="form-select form-select-sm" onchange="location = this.value;">
              {% for sorts in sorts %}
                <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div id="product-list" class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
          {% for product in products %}
            <div class="col">{{ product }}</div>
          {% endfor %}
        </div>

        <div class="category-pagination">
          <div>{{ pagination }}</div>
          <div class="category-pagination__results">{{ results }}</div>
        </div>
      {% else %}
        <div class="search-empty">
          <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
          <p class="search-empty__text">{{ text_no_results }}</p>
          <p class="search-empty__hint">Спробуйте інший запит або перегляньте наш каталог</p>
          <a href="{{ continue }}" class="btn btn-primary">Перейти до каталогу</a>
        </div>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
