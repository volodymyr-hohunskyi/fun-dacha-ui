<div class="product-thumb">
  <div class="image"><a href="{{ href }}"><img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}" class="img-fluid" loading="lazy"/></a></div>
  <div class="content">
    <div class="description">
      <h4><a href="{{ href }}">{{ name }}</a></h4>
      <p>{{ description }}</p>
      {% if price %}
        <div class="price">
          {% if not special %}
            <span class="price-new">{{ price }}</span>
          {% else %}
            <span class="price-new">{{ special }}</span> <span class="price-old">{{ price }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% if review_status and rating %}
        <div class="rating">
          {% for i in 1..5 %}
            {% if rating < i %}
              <span class="fa-stack"><i class="fa-regular fa-star fa-stack-1x"></i></span>
            {% else %}
              <span class="fa-stack"><i class="fa-solid fa-star fa-stack-1x"></i><i class="fa-regular fa-star fa-stack-1x"></i></span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="button w-100 d-flex">
      <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart" action="{{ cart_add }}" class="flex-fill">
        <input type="hidden" name="product_id" value="{{ product_id }}"/>
        <input type="hidden" name="quantity" value="{{ minimum }}"/>
        <button type="submit" class="btn btn-primary text-white add-to-cart-btn w-100"><i class="fa-solid fa-cart-shopping me-2" aria-hidden="true"></i>{{ button_cart }}</button>
      </form>
    </div>
  </div>
</div>