<div class="product-thumb">
  <div class="image">
    {% if special %}
      <span class="product-thumb__badge product-thumb__badge--sale">Акція</span>
    {% endif %}
    <a href="{{ href }}"><img src="{{ thumb }}" alt="{{ name }}" title="{{ name }}" loading="lazy"/></a>
  </div>
  <div class="content">
    <div class="description">
      <h4><a href="{{ href }}">{{ name }}</a></h4>
      {% if review_status and rating %}
        <div class="rating">
          {% for i in 1..5 %}
            {% if rating < i %}
              <i class="fa-regular fa-star"></i>
            {% else %}
              <i class="fa-solid fa-star"></i>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      <div class="product-thumb__price-row">
        <div class="product-thumb__prices">
          {% if price %}
            {% if not special %}
              <span class="product-thumb__current">{{ price }}</span>
            {% else %}
              <span class="product-thumb__sale">{{ special }}</span>
              <span class="product-thumb__was">{{ price }}</span>
            {% endif %}
          {% endif %}
        </div>
        <div class="product-thumb__cart">
          <form method="post" data-oc-toggle="ajax" data-oc-load="{{ cart }}" data-oc-target="#cart" action="{{ cart_add }}">
            <input type="hidden" name="product_id" value="{{ product_id }}"/>
            <input type="hidden" name="quantity" value="{{ minimum }}"/>
            <button type="submit" class="btn btn-primary text-white add-to-cart-btn" aria-label="{{ button_cart }}" title="{{ button_cart }}"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i></button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
