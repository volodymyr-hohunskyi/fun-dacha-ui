{{ header }}
<div id="cms-blog" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">
    {{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      <div class="blog-header">
        <h1 class="blog-header__title">{{ heading_title }}</h1>
        {% if description %}
          <p class="blog-header__desc">{{ description }}</p>
        {% endif %}
      </div>
      {% if articles %}
        <div class="blog-grid">
          {% for article in articles %}
            <article class="blog-card">
              {% if article.image %}
                <a href="{{ article.href }}" class="blog-card__image-link">
                  <img src="{{ article.image }}" alt="{{ article.name }}" title="{{ article.name }}" class="blog-card__image" loading="lazy"/>
                </a>
              {% endif %}
              <div class="blog-card__body">
                <div class="blog-card__meta">
                  <span class="blog-card__date"><i class="fa-regular fa-calendar"></i> {{ article.date_added }}</span>
                  {% if article.comment_total > 0 %}
                    <span class="blog-card__comments"><i class="fa-regular fa-comment"></i> {{ article.comment_total }}</span>
                  {% endif %}
                </div>
                <h2 class="blog-card__title"><a href="{{ article.href }}">{{ article.name }}</a></h2>
                <p class="blog-card__excerpt">{{ article.description }}</p>
                <a href="{{ article.href }}" class="blog-card__read-more">{{ button_continue }} <i class="fa-solid fa-arrow-right"></i></a>
              </div>
            </article>
          {% endfor %}
        </div>
        <div class="blog-pagination">
          <div class="blog-pagination__nav">{{ pagination }}</div>
          <div class="blog-pagination__results">{{ results }}</div>
        </div>
      {% else %}
        <div class="blog-empty">
          <i class="fa-solid fa-newspaper blog-empty__icon"></i>
          <p class="blog-empty__text">{{ text_no_results }}</p>
        </div>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
