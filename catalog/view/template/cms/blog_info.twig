{{ header }}
<div id="cms-blog" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">
    {{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      <article class="blog-article">
        <h1 class="blog-article__title">{{ heading_title }}</h1>
        <div class="blog-article__meta">
          <span><i class="fa-regular fa-user"></i> {{ author }}</span>
          <span><i class="fa-regular fa-calendar"></i> {{ date_added }}</span>
          {% if comment_total > 0 %}
            <span><i class="fa-regular fa-comment"></i> {{ comment_total }} {{ text_comment }}</span>
          {% endif %}
        </div>
        {% if image %}
          <img src="{{ image }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="blog-article__image" loading="lazy"/>
        {% endif %}
        <div class="blog-article__content">{{ description }}</div>
      </article>
      {% if comment %}
        <div id="comment-container" class="blog-comments">{{ comment }}</div>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}