{% if not assistant_embed %}
<button type="button" id="ai-assistant-toggle" class="ai-assistant-trigger" aria-label="{{ text_open }}">
  <span class="ai-assistant-trigger__icon" aria-hidden="true">🌱</span>
  <span class="ai-assistant-trigger__label">{{ text_assistant }}</span>
</button>
{% endif %}

<div id="ai-assistant-panel" class="ai-assistant-panel{% if assistant_embed %} ai-assistant-panel--embedded ai-assistant-panel--open{% endif %}" {% if assistant_embed %}aria-hidden="false"{% else %}aria-hidden="true"{% endif %} role="dialog" aria-modal="false" aria-label="{{ text_assistant }}">
  <div class="ai-assistant-panel__header">
    <span class="ai-assistant-panel__title">🌱 {{ text_assistant }}</span>
    {% if not assistant_embed %}
    <button type="button" class="ai-assistant-panel__close" id="ai-assistant-close" aria-label="{{ text_close }}">✕</button>
    {% endif %}
  </div>

  <div class="ai-assistant-panel__toolbar">
    <button type="button" class="ai-assistant-panel__reset" id="ai-assistant-reset">{{ text_start_over }}</button>
    {% if not assistant_embed and assistant_page_url %}
    <a href="{{ assistant_page_url }}" class="ai-assistant-panel__fullpage">{{ text_open_full_page }}</a>
    {% endif %}
  </div>

  <div class="ai-assistant-panel__body" id="ai-chat-scroll">
    <div class="ai-assistant-panel__messages" id="ai-chat-messages" role="log" aria-live="polite">
      <div class="ai-welcome" id="ai-welcome-screen">
        <div class="ai-welcome__icon" aria-hidden="true">🌱</div>
        <p class="ai-welcome__text">{{ text_welcome }}</p>
        <p class="ai-welcome__sub">{{ text_welcome_sub }}</p>
        <div class="ai-intent-list">
          <button type="button" class="ai-intent-btn" data-intent="consult" data-message="{{ text_intent_consult }}">{{ text_intent_consult }}</button>
          <button type="button" class="ai-intent-btn" data-intent="payment" data-message="{{ text_intent_payment }}">{{ text_intent_payment }}</button>
          <button type="button" class="ai-intent-btn" data-intent="delivery" data-message="{{ text_intent_delivery }}">{{ text_intent_delivery }}</button>
        </div>
      </div>
    </div>
  </div>

  <div class="ai-assistant-panel__quick-replies" id="ai-quick-replies" aria-label="{{ text_suggestions }}"></div>

  <div class="ai-assistant-panel__footer">
    <label class="visually-hidden" for="ai-chat-input">{{ text_placeholder }}</label>
    <textarea id="ai-chat-input" class="ai-assistant-panel__input" rows="1" placeholder="{{ text_placeholder }}" autocomplete="off"></textarea>
    <button type="button" id="ai-chat-send" class="ai-assistant-panel__send">{{ text_send }}</button>
  </div>

  <div class="ai-assistant-panel__callback">
    <a href="{{ callback_url }}" class="ai-callback-btn" id="ai-callback-btn">📞 {{ text_callback }}</a>
  </div>

  <div class="ai-assistant-panel__loading" id="ai-assistant-loading" aria-hidden="true">
    <span class="ai-assistant-panel__loading-dot"></span>
    <span class="ai-assistant-panel__loading-dot"></span>
    <span class="ai-assistant-panel__loading-dot"></span>
  </div>
</div>

<script>
window.aiAssistantConfig = {{ assistant_config_json|raw }};
</script>
