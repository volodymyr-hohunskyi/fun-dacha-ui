<fieldset id="shipping-address">
  <legend>{{ heading_title }}</legend>
  <div id="shipping-addresses" style="display: {% if addresses %}block{% else %}none{% endif %};">
    <div class="form-check">
      <input type="radio" name="shipping_existing" value="1" id="input-shipping-existing" class="form-check-input"{% if addresses %} checked{% endif %}/>
      <label for="input-shipping-existing" class="form-check-label">{{ text_address_existing }}</label>
    </div>
    <div class="form-check">
      <input type="radio" name="shipping_existing" value="0" id="input-shipping-new" class="form-check-input"{% if not addresses %} checked{% endif %}/>
      <label for="input-shipping-new" class="form-check-label">{{ text_address_new }}</label>
    </div>
  </div>
  <div id="shipping-existing" style="display: {% if addresses %}block{% else %}none{% endif %};">
    <select name="address_id" id="input-shipping-address" class="form-select">
      <option value="">{{ text_select }}</option>
      {% for address in addresses %}
        <option value="{{ address.address_id }}"{% if address.address_id == address_id %} selected{% endif %}>{{ address.firstname }} {{ address.lastname }},{% if address.company %} {{ address.company }},{% endif %} {{ address.address_1 }}, {{ address.city }}, {{ address.zone }}, {{ address.country }}</option>
      {% endfor %}
    </select>
    <div id="error-shipping-address" class="invalid-feedback"></div>
  </div>
  <br/>
  <div id="shipping-new" style="display: {% if not addresses %}block{% else %}none{% endif %};">
    <form id="form-shipping-address">
      <div class="row row-cols-1 row-cols-md-2">
        {# Hidden fields for compatibility - values will be set from Nova Poshta selection #}
        {# Customer name - get from session for logged in users #}
        {% if customer.firstname %}
          <input type="hidden" name="firstname" value="{{ customer.firstname }}" id="input-shipping-firstname-hidden"/>
        {% else %}
          <input type="hidden" name="firstname" value="" id="input-shipping-firstname-hidden"/>
        {% endif %}
        {% if customer.lastname %}
          <input type="hidden" name="lastname" value="{{ customer.lastname }}" id="input-shipping-lastname-hidden"/>
        {% else %}
          <input type="hidden" name="lastname" value="" id="input-shipping-lastname-hidden"/>
        {% endif %}
        <input type="hidden" name="company" value=""/>
        <input type="hidden" name="address_1" value=""/>
        <input type="hidden" name="address_2" value=""/>
        <input type="hidden" name="city" value=""/>
        <input type="hidden" name="postcode" value=""/>
        {# Shipping country ID - will be set to Ukraine (220) #}
        <input type="hidden" name="country_id" value="{{ shipping_country_id|default(220) }}" id="input-shipping-country-id"/>
        {# Shipping zone - will be set from selected region (Ukrainian oblast name) #}
        <input type="hidden" name="zone" value="" id="input-shipping-zone"/>
        {# Shipping zone ID - default to 0 for Ukraine regions #}
        <input type="hidden" name="zone_id" value="0" id="input-shipping-zone-id"/>
        
        {# Область (Region) - First field #}
        <div class="col mb-3 required">
          <label for="input-shipping-region" class="form-label">Область</label>
          <select name="shipping_region" id="input-shipping-region" class="form-select">
            <option value="">{{ text_select }}</option>
            {% for region in ukraine_regions %}
              <option value="{{ region }}"{% if region == shipping_region %} selected{% endif %}>{{ region }}</option>
            {% endfor %}
          </select>
          <div id="error-shipping-region" class="invalid-feedback"></div>
        </div>
        
        {# Місто (City) - Second field, populated via AJAX - always visible #}
        <div class="col mb-3 required" id="shipping-city-container" style="display: block;">
          <label for="input-shipping-city-np" class="form-label">Місто</label>
          <select name="ocnp_novaposhta_city" id="input-shipping-city-np" class="form-select">
            <option value="">Оберіть місто</option>
          </select>
          <div id="error-shipping-city-np" class="invalid-feedback"></div>
        </div>
        
        {# Відділення (Warehouse) - Third field, populated via AJAX - always visible #}
        <div class="col mb-3 required" id="shipping-warehouse-container" style="display: block;">
          <label for="input-shipping-warehouse-np" class="form-label">Відділення</label>
          <select name="ocnp_novaposhta_warehouse" id="input-shipping-warehouse-np" class="form-select">
            <option value="">Оберіть відділення</option>
          </select>
          <div id="error-shipping-warehouse-np" class="invalid-feedback"></div>
        </div>

        {% for custom_field in custom_fields %}

          {% if custom_field.type == 'select' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label for="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-label">{{ custom_field.name }}</label>
              <select name="custom_field[{{ custom_field.custom_field_id }}]" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-select">
                <option value="">{{ text_select }}</option>
                {% for custom_field_value in custom_field.custom_field_value %}
                  <option value="{{ custom_field_value.custom_field_value_id }}">{{ custom_field_value.name }}</option>
                {% endfor %}
              </select>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'radio' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label class="form-label">{{ custom_field.name }}</label>
              <div id="input-shipping-custom-field-{{ custom_field.custom_field_id }}">
                {% for custom_field_value in custom_field.custom_field_value %}
                  <div class="form-check">
                    <input type="radio" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" id="input-shipping-custom-value-{{ custom_field_value.custom_field_value_id }}" class="form-check-input"/> <label for="input-shipping-custom-value-{{ custom_field_value.custom_field_value_id }}" class="form-check-label">{{ custom_field_value.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'checkbox' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label class="form-label">{{ custom_field.name }}</label>
              <div id="input-shipping-custom-field-{{ custom_field.custom_field_id }}">
                {% for custom_field_value in custom_field.custom_field_value %}
                  <div class="form-check">
                    <input type="checkbox" name="custom_field[{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" id="input-shipping-custom-value-{{ custom_field_value.custom_field_value_id }}" class="form-check-input"/> <label for="input-shipping-custom-value-{{ custom_field_value.custom_field_value_id }}" class="form-check-label">{{ custom_field_value.name }}</label>
                  </div>
                {% endfor %}
              </div>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'text' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label for="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-label">{{ custom_field.name }}</label>
              <input type="text" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="{{ custom_field.name }}" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-control"/>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'textarea' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label for="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-label">{{ custom_field.name }}</label>
              <textarea name="custom_field[{{ custom_field.custom_field_id }}]" rows="5" placeholder="{{ custom_field.value }}" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-control">{{ custom_field.value }}</textarea>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'file' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label class="form-label">{{ custom_field.name }}</label>
              <div>
                <button type="button" data-oc-toggle="upload" data-oc-url="{{ upload }}" data-oc-size-max="{{ config_file_max_size }}" data-oc-size-error="{{ error_upload_size }}" data-oc-target="#input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="btn btn-light"><i class="fa-solid fa-upload"></i> {{ button_upload }}</button>
                <input type="hidden" name="custom_field{{ custom_field.custom_field_id }}]" value="" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}"/>
                <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
              </div>
            </div>
          {% endif %}

          {% if custom_field.type == 'date' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label for="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-label">{{ custom_field.name }}</label>
              <input type="date" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="{{ custom_field.name }}" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-control"/>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'time' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label for="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-label">{{ custom_field.name }}</label>
              <input type="time" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="{{ custom_field.name }}" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-control"/>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

          {% if custom_field.type == 'datetime' %}
            <div class="col mb-3{% if custom_field.required %} required{% endif %} custom-field custom-field-{{ custom_field.custom_field_id }}">
              <label for="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-label">{{ custom_field.name }}</label>
              <input type="datetime-local" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ custom_field.value }}" placeholder="{{ custom_field.name }}" id="input-shipping-custom-field-{{ custom_field.custom_field_id }}" class="form-control"/>
              <div id="error-shipping-custom-field-{{ custom_field.custom_field_id }}" class="invalid-feedback"></div>
            </div>
          {% endif %}

        {% endfor %}

      </div>
      
      {# Payment disclaimer - 20 UAH #}
      <div class="row mt-3">
        <div class="col-12 mb-3">
          <div class="alert alert-warning" style="margin-bottom: 0;">
            <i class="fa-solid fa-circle-exclamation"></i> <strong>Оплата при отриманні (післяплата) здійснюється за тарифами Нової Пошти. Комісія складає 2% від суми замовлення + 20 грн за оформлення переказу.</strong>
          </div>
        </div>
      </div>
      
      <div class="text-end mb-3">
        <button type="submit" id="button-shipping-address" class="btn btn-primary">{{ button_continue }}</button>
      </div>
    </form>
  </div>
</fieldset>
<script type="text/javascript"><!--
$('input[name=\'shipping_existing\']').on('change', function() {
    if ($(this).val() == 1) {
        $('#shipping-existing').show();
        $('#shipping-new').hide();
    } else {
        $('#shipping-existing').hide();
        $('#shipping-new').show();
    }
});

// Nova Poshta AJAX loading: Region → City → Warehouse
// When region is selected, load cities
$('#input-shipping-region').on('change', function() {
    var selectedRegion = $(this).val();
    var citySelect = $('#input-shipping-city-np');
    var cityContainer = $('#shipping-city-container');
    var warehouseContainer = $('#shipping-warehouse-container');
    var warehouseSelect = $('#input-shipping-warehouse-np');
    
    if (!selectedRegion) {
        citySelect.empty().append('<option value="">Оберіть місто</option>');
        warehouseSelect.empty().append('<option value="">Оберіть відділення</option>');
        cityContainer.hide();
        warehouseContainer.hide();
        return;
    }
    
    // Update shipping_zone
    $('#input-shipping-zone').val(selectedRegion);
    
    cityContainer.show();
    
    // Reset city and warehouse
    citySelect.empty().append('<option value="">Завантаження...</option>');
    warehouseSelect.empty().append('<option value="">Оберіть відділення</option>');
    warehouseContainer.hide();
    
    // Find region Ref by name
    $.ajax({
        url: 'index.php?route=extension/ocnp/shipping/novaposhta.getCities&language={{ language }}',
        type: 'post',
        data: { area_description: selectedRegion },
        dataType: 'json',
        success: function(response) {
            if (response.success && response.cities && response.cities.length > 0) {
                citySelect.empty().append('<option value="">Оберіть місто</option>');
                $.each(response.cities, function(index, city) {
                    var option = $('<option>')
                        .attr('value', city.Description)
                        .attr('data-ref', city.Ref)
                        .text(city.Description);
                    citySelect.append(option);
                });
            } else {
                citySelect.empty().append('<option value="">Міста не знайдено</option>');
            }
        },
        error: function() {
            citySelect.empty().append('<option value="">Помилка завантаження</option>');
        }
    });
});

// When city is selected, load warehouses
$('#input-shipping-city-np').on('change', function() {
    var selectedOption = $(this).find('option:selected');
    var cityRef = selectedOption.data('ref');
    var cityDescription = $(this).val();
    var warehouseSelect = $('#input-shipping-warehouse-np');
    var warehouseContainer = $('#shipping-warehouse-container');
    
    if (!cityRef || !cityDescription) {
        warehouseSelect.empty().append('<option value="">Оберіть відділення</option>');
        warehouseContainer.hide();
        return;
    }
    
    // Update hidden city field
    $('input[name="city"]').val(cityDescription);
    
    if (cityRef) {
        warehouseContainer.show();
        warehouseSelect.empty().append('<option value="">Завантаження...</option>');
        
        $.ajax({
            url: 'index.php?route=extension/ocnp/shipping/novaposhta.getWarehouses&language={{ language }}',
            type: 'post',
            data: { city_ref: cityRef },
            dataType: 'json',
            success: function(response) {
                if (response.success && response.warehouses && response.warehouses.length > 0) {
                    warehouseSelect.empty().append('<option value="">Оберіть відділення</option>');
                    $.each(response.warehouses, function(index, warehouse) {
                        var option = $('<option>')
                            .attr('value', warehouse.Description)
                            .attr('data-ref', warehouse.Ref)
                            .text(warehouse.Description);
                        warehouseSelect.append(option);
                    });
                } else {
                    warehouseSelect.empty().append('<option value="">Відділення не знайдено</option>');
                }
            },
            error: function() {
                warehouseSelect.empty().append('<option value="">Помилка завантаження</option>');
            }
        });
    }
});

// When warehouse is selected, update hidden address fields
$('#input-shipping-warehouse-np').on('change', function() {
    var warehouseDescription = $(this).val();
    var selectedOption = $(this).find('option:selected');
    var warehouseRef = selectedOption.data('ref');
    
    if (warehouseDescription) {
        // Update hidden address_1 field with warehouse info
        $('input[name="address_1"]').val(warehouseDescription);
        
        // Update shipping zone_id lookup if needed
        var regionName = $('#input-shipping-region').val();
        if (regionName) {
            $('#input-shipping-zone').val(regionName);
        }
    }
});

// Show Nova Poshta fields on page load if region is already selected
$(document).ready(function() {
    var selectedRegion = $('#input-shipping-region').val();
    if (selectedRegion) {
        $('#shipping-city-container, #shipping-warehouse-container').show();
        $('#input-shipping-region').trigger('change');
    }
});

// Existing Shipping Address
$('#input-shipping-address').on('change', function() {
    var element = this;

    chain.attach(function() {
        return $.ajax({
            url: 'index.php?route=checkout/shipping_address.address&language={{ language }}&address_id=' + $(element).val(),
            dataType: 'json',
            beforeSend: function() {
                $(element).prop('disabled', true);
            },
            complete: function() {
                $(element).prop('disabled', false);
            },
            success: function(json) {
                console.log(json);

                $('#input-shipping-address').removeClass('is-invalid');
                $('#error-shipping-address').removeClass('d-block');

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#input-shipping-address').addClass('is-invalid');
                    $('#error-shipping-address').html(json['error']).addClass('d-block');
                }

                if (json['success']) {
                    $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                    $('#input-shipping-method').val('');
                    $('#input-payment-method').val('');

                    $('#checkout-confirm').load('index.php?route=checkout/confirm.confirm&language={{ language }}');
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

// New Shipping Address - Modified for Nova Poshta
$('#form-shipping-address').on('submit', function(e) {
    e.preventDefault();

    chain.attach(function() {
        // Get customer name from session or form
        var firstname = '';
        var lastname = '';
        
        // Try to get from customer session data or other sources
        if (typeof window.customerData !== 'undefined') {
            firstname = window.customerData.firstname || '';
            lastname = window.customerData.lastname || '';
        }
        
        // Set hidden fields
        $('#input-shipping-firstname-hidden').val(firstname);
        $('#input-shipping-lastname-hidden').val(lastname);
        
        // Ensure region, city, warehouse are set
        var region = $('#input-shipping-region').val();
        var city = $('#input-shipping-city-np').val();
        var warehouse = $('#input-shipping-warehouse-np').val();
        
        if (region) {
            $('#input-shipping-zone').val(region);
        }
        if (city) {
            $('input[name="city"]').val(city);
        }
        if (warehouse) {
            $('input[name="address_1"]').val(warehouse);
        }
        
        return $.ajax({
            url: 'index.php?route=checkout/shipping_address.save&language={{ language }}',
            type: 'post',
            data: $('#form-shipping-address').serialize(),
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            beforeSend: function() {
                $('#button-shipping-address').button('loading');
            },
            complete: function() {
                $('#button-shipping-address').button('reset');
            },
            success: function(json) {
                console.log(json);

                $('#form-shipping-address').find('.is-invalid').removeClass('is-invalid');
                $('#form-shipping-address').find('.invalid-feedback').removeClass('d-block');

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    if (json['error']['warning']) {
                        $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error']['warning'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                    }

                    for (i in json['error']) {
                        for (key in json['error']) {
                            $('#input-shipping-' + key.replaceAll('_', '-')).addClass('is-invalid').find('.form-control, .form-select, .form-check-input, .form-check-label').addClass('is-invalid');
                            $('#error-shipping-' + key.replaceAll('_', '-')).html(json['error'][key]).addClass('d-block');
                        }
                    }
                }

                if (json['success']) {
                    $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                    $('#form-shipping-address')[0].reset();

                    var html = '<option value="">{{ text_select|escape('js') }}</option>';

                    if (json['addresses']) {
                        for (i in json['addresses']) {
                            html += '<option value="' + json['addresses'][i]['address_id'] + '">' + json['addresses'][i]['firstname'] + ' ' + json['addresses'][i]['lastname'] + ', ' + (json['addresses'][i]['company'] ? json['addresses'][i]['company'] + ', ' : '') + json['addresses'][i]['address_1'] + ', ' + json['addresses'][i]['city'] + ', ' + json['addresses'][i]['zone'] + ', ' + json['addresses'][i]['country'] + '</option>';
                        }
                    }

                    // Shipping Address
                    $('#input-shipping-address').html(html);

                    $('#input-shipping-address').val(json['address_id']);

                    $('#shipping-addresses').css({display: 'block'});

                    $('#input-shipping-existing').trigger('click');

                    // Payment Address
                    var payment_address_id = $('#input-payment-address').val();

                    $('#input-payment-address').html(html);

                    if (payment_address_id) {
                        $('#input-payment-address').val(payment_address_id);
                    }

                    $('#payment-addresses').css({display: 'block'});

                    $('#input-payment-existing').trigger('click');

                    $('#input-shipping-method').val('');
                    $('#input-payment-method').val('');

                    $('#checkout-confirm').load('index.php?route=checkout/confirm.confirm&language={{ language }}');
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});
//--></script>
