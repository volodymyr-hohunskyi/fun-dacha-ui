{% if products %}
  {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if min_order_error %}
    <div class="alert alert-warning alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ min_order_error }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if error_stock %}
    <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_stock }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if attention %}
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ attention }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}

  <h1>{{ heading_title }}</h1>

  <div class="row cart-layout">
    <div class="col-lg-8">
      <div id="output-cart" class="cart-items">
        {% for product in products %}
          <div class="cart-item">
            <div class="cart-item__image">
              {% if product.thumb %}
                <a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy"/></a>
              {% endif %}
            </div>
            <div class="cart-item__details">
              <a href="{{ product.href }}" class="cart-item__name">{{ product.name }}</a>
              {% if not product.stock %}<span class="cart-item__unavailable">Немає в наявності</span>{% endif %}
              {% if product.cart_pack %}
                <div class="cart-item__pack">{{ product.cart_pack.pack_label }}</div>
              {% endif %}
              {% for option in product.option %}
                {% if not product.cart_pack %}
                  <div class="cart-item__option">{{ option.name }}: {% if option.pack_display_html %}{{ option.pack_display_html|raw }}{% else %}{{ option.value }}{% endif %}</div>
                {% endif %}
              {% endfor %}
              <div class="cart-item__price-mobile d-lg-none">
                {% if product.cart_pack %}
                  {% if product.cart_pack.line_was %}<span class="cart-item__sale">{{ product.cart_pack.line_sale }}</span> <span class="cart-item__was">{{ product.cart_pack.line_was }}</span>{% else %}{{ product.cart_pack.line_sale }}{% endif %}
                {% elseif product.price_was %}
                  <span class="cart-item__sale">{{ product.price }}</span> <span class="cart-item__was">{{ product.price_was }}</span>
                {% else %}
                  {{ product.price }}
                {% endif %}
              </div>
            </div>
            <div class="cart-item__qty">
              <form method="post" data-oc-target="#shopping-cart" id="form-quantity-{{ product.cart_id }}" class="mb-0">
                <div class="input-group input-group-qty-compact flex-nowrap">
                  <button type="button" class="btn btn-outline-secondary btn-qty-step" onclick="changeCartQuantity({{ product.cart_id }}, -1)"><i class="fa-solid fa-minus"></i></button>
                  <input type="text" name="quantity" value="{{ product.quantity }}" size="1" class="form-control form-control-sm text-center" onchange="updateCartQuantity({{ product.cart_id }})"/>
                  <button type="button" class="btn btn-outline-secondary btn-qty-step" onclick="changeCartQuantity({{ product.cart_id }}, 1)"><i class="fa-solid fa-plus"></i></button>
                </div>
                <input type="hidden" name="key" value="{{ product.cart_id }}"/>
              </form>
            </div>
            <div class="cart-item__price d-none d-lg-block">
              {% if product.cart_pack %}
                {% if product.cart_pack.line_was %}<span class="cart-item__sale">{{ product.cart_pack.line_sale }}</span> <span class="cart-item__was">{{ product.cart_pack.line_was }}</span>{% else %}{{ product.cart_pack.line_sale }}{% endif %}
              {% elseif product.price_was %}
                <span class="cart-item__sale">{{ product.price }}</span> <span class="cart-item__was">{{ product.price_was }}</span>
              {% else %}
                {{ product.price }}
              {% endif %}
            </div>
            <div class="cart-item__total">{{ product.total }}</div>
            <a href="{{ product.remove }}" class="cart-item__remove" title="{{ button_remove }}"><i class="fa-solid fa-xmark"></i></a>
          </div>
        {% endfor %}
      </div>

      {% if modules %}
        <div class="cart-modules mt-3">
          <h2>{{ text_next }}</h2>
          <p>{{ text_next_choice }}</p>
          <div id="accordion" class="accordion">
            {% for module in modules %}
              {{ module }}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="col-lg-4">
      <div class="cart-summary">
        <h3 class="cart-summary__title">Ваше замовлення</h3>
        <div class="cart-summary__totals" id="checkout-total">
          {% for total in totals %}
            <div class="cart-summary__row{% if loop.last %} cart-summary__row--total{% endif %}">
              <span>{{ total.title }}</span>
              <span>{{ total.text }}</span>
            </div>
          {% endfor %}
        </div>
        <div class="cart-summary__actions">
          {% if checkout and can_proceed_to_checkout %}
            <a href="{{ checkout }}" id="checkout-button" class="btn btn-primary w-100 btn-lg">{{ button_checkout }} <i class="fa-solid fa-arrow-right ms-2"></i></a>
          {% else %}
            <button type="button" id="checkout-button" class="btn btn-primary w-100 btn-lg" disabled>{{ button_checkout }}</button>
          {% endif %}
          <a href="{{ continue }}" class="btn btn-outline-secondary w-100 mt-2">{{ button_shopping }}</a>
        </div>
        <div class="cart-summary__trust">
          <div class="cart-summary__trust-item"><i class="fa-solid fa-truck-fast"></i> Нова Пошта 1-3 дні</div>
          <div class="cart-summary__trust-item"><i class="fa-solid fa-money-bill-wave"></i> Оплата при отриманні</div>
          <div class="cart-summary__trust-item"><i class="fa-solid fa-shield-halved"></i> Безпечне замовлення</div>
        </div>
      </div>
    </div>
  </div>
{% else %}
  <div class="cart-empty">
    <i class="fa-solid fa-cart-shopping fa-4x"></i>
    <h2 class="cart-empty__title">{{ heading_title }}</h2>
    <p class="cart-empty__text">{{ text_no_results }}</p>
    <a href="{{ continue }}" class="btn btn-primary btn-lg">Перейти до каталогу <i class="fa-solid fa-arrow-right ms-2"></i></a>
  </div>
{% endif %}
